# Server-only. Never expose this value to browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Public Vercel stays in demo mode. Workspace mode requires a provisioned InsForge workspace.
SEARCH_ACCESS_MODE=demo
FLIGHTSTORY_WORKSPACE_ID=
# Publishable client settings used by InsForge workspace sign-in and the server-side RLS client.
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
OPENROUTER_API_KEY=
PORT=3000
